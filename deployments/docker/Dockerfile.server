# Build stage
FROM golang:1.21-alpine AS builder

WORKDIR /build

# Install dependencies
RUN apk add --no-cache git make

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build
RUN CGO_ENABLED=1 GOOS=linux go build -a -installsuffix cgo -o server cmd/server/main.go

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates sqlite

WORKDIR /app

# Copy binary
COPY --from=builder /build/server .

# Copy config template
COPY config/server.toml ./config/

# Create directories
RUN mkdir -p /app/data /app/logs /app/certs

# Expose ports
EXPOSE 7000 8080

CMD ["./server", "-c", "config/server.toml"]
