# AWECloud Signaling Server 配置文件

# Web/API 服务配置
[web]
listen_addr = "0.0.0.0"
listen_port = 8080
# 管理员凭据通过 ADMIN_USERNAME 和 ADMIN_PASSWORD 环境变量配置。

# 安全配置
[security]
jwt_secret = "your-secret-key-change-in-production"
jwt_expire_hours = 24
# 单次用户模拟的最长时长；默认 8 小时。
user_simulation_max_hours = 8
# 仅限本地隔离开发环境。生产环境保持 false。
allow_localhost_admin_debug = false

# 新资源业务 Feature Flags。默认全部关闭；启用前必须满足对应里程碑退出条件。
[feature_flags]
resource_model_write = false
resource_reconciliation = false
resource_allocation = false
management_context_v2 = false
management_web_v2 = false
tenant_resource_read_v2 = false
session_authorization_v2 = false
legacy_write_freeze = false

# 数据库配置
[database]
type = "sqlite"
path = "data/server.db"

# Updater 制品目录由 Server 通过公开 HTTPS 索引同步，发布流水线不调用管理员 API。
[updater]
catalog_url = "https://minio-api.example.com/vscode/awecloud-signaling/updater/catalog.json"
artifact_base_url = "https://minio-api.example.com/vscode/awecloud-signaling"

# 日志配置
[log]
level = "info"

# Headscale 配置
# Server 通过 Headscale API 管理节点和认证
# [tailscale] 是为向下兼容保留的配置段名称
[tailscale]
# Headscale API 地址（Server 内部访问，用于管理 API）
# 环境变量：HEADSCALE_URL
# 
# 配置说明：
# 1. Kubernetes 环境（集群内部访问，推荐）：
#    headscale_url = "http://headscale.beagle-access.svc.cluster.local:8080"
# 
# 2. Kubernetes 环境（通过 Ingress）：
#    headscale_url = "https://signaling.example.com/headscale"
headscale_url = "http://headscale:8080"

# Headscale 公网地址（Agent/Desktop 的内嵌网络客户端访问）
# 环境变量：HEADSCALE_PUBLIC_URL
# 
# 重要：内嵌网络客户端固定使用 /ts2021 路径，不支持自定义路径前缀！
# 所以这里不能带 /headscale 后缀，必须是纯域名
# 
# 正确：headscale_public_url = "https://signaling.example.com"
# 错误：headscale_public_url = "https://signaling.example.com/headscale"
headscale_public_url = "https://signaling.example.com"

# Headscale API 密钥（建议通过环境变量配置）
# 环境变量：HEADSCALE_API_KEY
# 生成方式：headscale apikeys create --expiration 36500d
headscale_api_key = ""

# OpenTelemetry 配置
# 设置 endpoint 后自动启用，留空则禁用
[telemetry]
# OTLP Endpoint
# 环境变量：OTEL_EXPORTER_OTLP_ENDPOINT
# 
# K8s 内部：http://otel-collector.beagle-devops:4317
# 外网访问：https://otel.ali.example.com:443
endpoint = ""

# 服务名称（默认：signal_server）
# 环境变量：OTEL_SERVICE_NAME
name = "signal_server"

# 服务命名空间（默认：default）
# 环境变量：OTEL_SERVICE_NAMESPACE
namespace = "default"

# 集群标识（默认：default）
# 环境变量：OTEL_SERVICE_CLUSTER
# 用于标识服务所在的业务集群/数据来源，在 Jaeger 中显示为 service.cluster tag
# 注意：这与 k8s.cluster.name 不同，后者表示 OTEL Collector 所在的 K8s 集群
cluster = "default"

# Logto 配置（Desktop 登录）
# 设置 endpoint 和 app_id 后启用 Desktop Logto 登录
[logto]
# Logto 端点地址
# 环境变量：LOGTO_ENDPOINT
# 示例：https://login.example.com
endpoint = ""

# Logto 应用 ID
# 环境变量：LOGTO_APP_ID
app_id = ""

# Logto 应用密钥
# 环境变量：LOGTO_APP_SECRET
app_secret = ""

# OAuth 回调 URL
# 环境变量：LOGTO_CALLBACK_URL
# 示例：https://signaling.example.com/auth/desktop/callback
callback_url = ""

# API Resource（可选）
# 环境变量：LOGTO_RESOURCE
resource = ""

# 请求的 Scopes（逗号分隔，默认：openid,profile,email）
# 环境变量：LOGTO_SCOPES
scopes = "openid,profile,email"
