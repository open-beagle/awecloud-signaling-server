# AWECloud Signaling Server 配置文件

# Web/API 服务配置
[web]
listen_addr = "0.0.0.0"
listen_port = 8080
default_admin_username = "admin"
default_admin_password = "admin123"

# 安全配置
[security]
jwt_secret = "your-secret-key-change-in-production"
jwt_expire_hours = 24

# 数据库配置
[database]
type = "sqlite"
path = "data/server.db"

# 日志配置
[log]
level = "info"
file = ""

# Tailscale/Headscale 配置
# Server 通过 Headscale API 管理节点和认证
[tailscale]
# Headscale API 地址
# 环境变量：HEADSCALE_URL
# 
# 配置说明：
# 1. 本地开发（本地运行 Headscale）：
#    headscale_url = "http://localhost:8080"
# 
# 2. Kubernetes 环境（通过 Ingress）：
#    headscale_url = "https://ts.ali.wodcloud.com/headscale"
#    或 headscale_url = "http://ts.ali.wodcloud.com/headscale"
# 
# 3. Kubernetes 环境（通过 port-forward）：
#    kubectl port-forward -n beagle-access svc/headscale 8080:8080
#    headscale_url = "http://localhost:8080"
# 
# 4. Kubernetes 环境（集群内部访问）：
#    headscale_url = "http://headscale.beagle-access.svc.cluster.local:8080"
headscale_url = "http://headscale:8080"

# Headscale API 密钥（建议通过环境变量配置）
# 环境变量：HEADSCALE_API_KEY
# 生成方式：headscale apikeys create --expiration 365d
headscale_api_key = ""
