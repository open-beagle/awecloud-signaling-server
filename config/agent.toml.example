# AWECloud Signaling Agent 配置文件

# Agent 配置
# 注意：name、device 和 token 可以通过环境变量覆盖
# 环境变量：SIGNAL_NAME, SIGNAL_DEVICE, SIGNAL_TOKEN
# 旧变量（过渡期兼容）：AGENT_NAME, AGENT_DEVICE, AGENT_TOKEN
[agent]
name = ""                         # Agent 名称（区域），如 beijing.beagle
device = ""                       # 设备名，用于标识同一 Agent 下的不同设备
token = ""                        # Agent Token，从 Server 管理界面获取

# Server 连接配置
# Server 地址配置优先级：
#   1. 环境变量 SIGNAL_SERVER（最高优先级）
#   2. 旧环境变量 AGENT_ADDRESS（过渡期兼容）
#   3. 配置文件 agent.server
#   4. 编译时注入的 BUILD_URL（通过 -ldflags）
#   5. 硬编码默认值 "http://localhost:8080"（最低优先级）
#
# 地址格式支持：
#   - 完整URL: "https://signaling.example.com" (推荐，自动使用443端口)
#   - 带端口: "https://signaling.example.com:8080"
#   - HTTP: "http://signaling.example.com" (自动使用80端口)
#   - 纯域名: "signaling.example.com" (自动补充 http://)
#   - IP地址: "192.168.1.100" (自动补充 http://)
#
# 协议说明：
#   - https:// - gRPC 使用 TLS 连接（自动跳过证书验证，支持自签名证书）
#   - http://  - gRPC 使用明文连接
#
# 端口说明：
#   - Server 使用 HTTP/2 统一端口，Web/API 和 gRPC 复用同一端口
#   - 如果URL中指定了端口，使用指定的端口
#   - 如果URL中没有端口，https 使用 443，http 使用 80
server = ""

# Tunnel 配置（隧道）
# Agent 通过隧道连接到控制平面
# 认证信息由 Server 在注册时下发
[tunnel]
# 隧道状态存储目录
# - 如果配置：使用本地持久化，Server 作为备份（推荐生产环境）
# - 如果为空：使用临时目录，完全依赖 Server（适合临时容器）
# - 支持 ~ 扩展为用户主目录
# - 容器环境建议挂载此目录为持久卷
state_dir = "~/.config/signaling/"

# 状态同步到 Server 的间隔（分钟）
state_sync_interval = 5

# 是否启用 SSH
# 启用后，Desktop 用户可以通过隧道网络直接 SSH 到此 Agent
# 需要配合 Server 端的 SSH 授权策略使用
# 注意：SSH 基于 tsnet 用户态实现，不需要 root 权限
enable_ssh = false

# Visitor 配置（服务访问）
# Visitor 在局域网 IP 上监听端口，将流量通过 Headscale 私有网络转发到其他节点暴露的服务
[visitor]
# 可选，手动指定监听地址，留空则自动检测局域网 IP
# 自动检测会过滤虚拟网卡（Docker、K8s CNI、VMware 等），优先选择物理网卡
# 如果自动检测不准确，可以手动指定
listen_addr = ""

# HTTPS Headscale 证书说明：
# 如果 Headscale 使用自签名证书，需要将根证书导入系统证书库：
# - Ubuntu/Debian: 
#   sudo cp ca.crt /usr/local/share/ca-certificates/
#   sudo update-ca-certificates
# - CentOS/RHEL:
#   sudo cp ca.crt /etc/pki/ca-trust/source/anchors/
#   sudo update-ca-trust

# 健康检查配置
[health]
port = 8090  # 健康检查HTTP端口，用于Kubernetes探测

# 日志配置
[log]
level = "info"

# OpenTelemetry 配置（可选）
# 设置 endpoint 后自动启用追踪
[telemetry]
# OTLP Endpoint
# 环境变量：OTEL_EXPORTER_OTLP_ENDPOINT
# 
# - http:// 前缀使用非安全连接
# - https:// 前缀使用 TLS
# - 不指定端口时：https 默认 443，http 默认 80
# 
# K8s 内部：http://otel-collector.beagle-devops:4317
# 外网访问：https://otel.ali.example.com:443
endpoint = ""

# 服务名称（默认：signaling-agent）
# 环境变量：OTEL_SERVICE_NAME
name = "signaling-agent"

# 服务命名空间（默认：default）
# 环境变量：OTEL_SERVICE_NAMESPACE
namespace = "default"

# 集群标识（默认：default）
# 环境变量：OTEL_SERVICE_CLUSTER
# 用于标识服务所在的业务集群/数据来源，在 Jaeger 中显示为 service.cluster tag
# 注意：这与 k8s.cluster.name 不同，后者表示 OTEL Collector 所在的 K8s 集群
cluster = "default"

# CloudIDE 专属配置（仅 CloudIDE 模式生效）
# CloudIDE 模式由 Server 注册响应中的 user_role=client 决定
# 环境变量：SIGNAL_SSH_CONFIG, SIGNAL_SOCKS, SIGNAL_SOCKS_ADDR, SIGNAL_DIAL_SOCKET
[cloudide]
# 是否自动维护 ~/.ssh/config（劫持 100.64.* 的 SSH 连接）
ssh_config = false

# 是否启用 SOCKS5 代理（供非 SSH 程序按需使用）
socks = false

# SOCKS5 监听地址
socks_addr = "127.0.0.1:1080"

# dial 子命令的 Unix Socket 路径
dial_socket = "/tmp/signaling.sock"

# K8S API 代理配置
# 启用后，Agent 在 tsnet 网络上监听 K8S API 端口，
# 通过 Impersonation 机制代理 Desktop 用户访问 K8S 集群
# 环境变量：SIGNAL_K8S_ENABLED, SIGNAL_K8S_KUBECONFIG, SIGNAL_K8S_API_SERVER, SIGNAL_K8S_LISTEN_PORT
[k8s]
# 是否启用 K8S API 代理
enabled = false

# kubeconfig 路径（默认 ~/.kube/config，InCluster 环境自动检测）
kubeconfig = ""

# K8S API Server 地址（留空则从 kubeconfig 自动获取）
api_server = ""

# tsnet 监听端口（默认 50050）
listen_port = 50050

# Kubernetes Service 清单配置
# 启用后，Agent 采集显式 Namespace 中的 Service Port，并通过
# workload_inventory_v1 上报 Server。
# 环境变量：SIGNAL_SVC_ENABLED, SIGNAL_SVC_KUBECONFIG, SIGNAL_SVC_LABEL_SELECTOR, SIGNAL_SVC_NAMESPACES, SIGNAL_SVC_LISTEN_PORT_BASE
[svc]
# 是否启用 K8S Service 发现
enabled = false

# kubeconfig 路径（空则使用 InCluster 配置）
kubeconfig = ""

# 可选标签选择器；空值采集显式 Namespace 中的全部 Service
label_selector = ""

# 必须显式配置；空值不采集，禁止隐式扫描整个集群
# 环境变量 SIGNAL_SVC_NAMESPACES 使用逗号分隔
namespaces = []

# tsnet gRPC 监听端口（默认 50051）
listen_port_base = 50051

# Kubernetes Pod 清单配置（默认关闭）
# 启用后采集显式 Namespace 中当前 Running、Ready 的 Pod/Container。
[container]
enabled = false
kubeconfig = ""
# 可选标签选择器；空值采集显式 Namespace 中的全部 Pod
label_selector = ""
# 必须显式配置；空值不采集
namespaces = []
provider_label = "beagle.io/provider"
workspace_label = "beagle.io/workspace"
generation_label = "beagle.io/workspace-generation"
container_name_label = "beagle.io/container"
lease_seconds = 120
