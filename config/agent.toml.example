# AWECloud Signaling Agent 配置文件

# Agent 配置
# 注意：name 和 token 可以通过环境变量覆盖
# 环境变量：AGENT_NAME, AGENT_TOKEN
[agent]
name = "agent-dev-001"
token = "your-agent-token-from-server"

# Server 连接配置
# Server 地址配置优先级：
#   1. 环境变量 AGENT_ADDRESS（最高优先级）
#   2. 配置文件 server.address
#   3. 编译时注入的 BUILD_URL（通过 -ldflags）
#   4. 硬编码默认值 "http://localhost:8080"（最低优先级）
#
# 地址格式支持：
#   - 完整URL: "https://signaling.example.com" (推荐，自动使用443端口)
#   - 带端口: "https://signaling.example.com:8080"
#   - HTTP: "http://signaling.example.com" (自动使用80端口)
#   - 纯域名: "signaling.example.com" (自动补充 http://)
#   - IP地址: "192.168.1.100" (自动补充 http://)
#
# 协议说明：
#   - https:// - gRPC 使用 TLS 连接（自动跳过证书验证，支持自签名证书）
#   - http://  - gRPC 使用明文连接
#
# 端口说明：
#   - Server 使用 HTTP/2 统一端口，Web/API 和 gRPC 复用同一端口
#   - 如果URL中指定了端口，使用指定的端口
#   - 如果URL中没有端口，https 使用 443，http 使用 80
[server]
address = "http://localhost:8080"

# Tailscale 配置
# Agent 通过 Tailscale (tsnet) 连接到 Headscale 控制平面
# 认证信息（ControlURL、AuthKey）由 Server 在注册时下发
[tailscale]
# Tailscale 状态存储目录
# - 如果配置：使用本地持久化，Server 作为备份（推荐生产环境）
# - 如果为空：使用临时目录，完全依赖 Server（适合临时容器）
# - 支持 ~ 扩展为用户主目录
# - 容器环境建议挂载此目录为持久卷
state_dir = "~/.config/awecloud-signaling/"

# 状态同步到 Server 的间隔（分钟）
state_sync_interval = 5

# Visitor 配置（服务访问）
# Visitor 在局域网 IP 上监听端口，将流量通过 Tailscale VPN 转发到其他节点暴露的服务
[visitor]
# 可选，手动指定监听地址，留空则自动检测局域网 IP
# 自动检测会过滤虚拟网卡（Docker、K8s CNI、VMware 等），优先选择物理网卡
# 如果自动检测不准确，可以手动指定
listen_addr = ""

# HTTPS Headscale 证书说明：
# 如果 Headscale 使用自签名证书，需要将根证书导入系统证书库：
# - Ubuntu/Debian: 
#   sudo cp ca.crt /usr/local/share/ca-certificates/
#   sudo update-ca-certificates
# - CentOS/RHEL:
#   sudo cp ca.crt /etc/pki/ca-trust/source/anchors/
#   sudo update-ca-trust

# 健康检查配置
[health]
port = 8090  # 健康检查HTTP端口，用于Kubernetes探测

# 日志配置
[log]
level = "info"
