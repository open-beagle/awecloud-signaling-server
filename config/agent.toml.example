# AWECloud Signaling Agent 配置文件

# Agent 配置
# 注意：agent_name 和 agent_token 可以通过环境变量覆盖
# 环境变量：AGENT_NAME, AGENT_TOKEN
[agent]
agent_name = "agent-dev-001"
agent_token = "your-agent-token-from-server"

# Server 连接配置
# 注意：address 可以通过环境变量 SERVER_ADDR 覆盖
[server]
address = "localhost"
port = 7000        # FRP服务端口（WebSocket）
grpc_port = 8080   # gRPC端口（HTTP/2统一端口，同时支持HTTP和gRPC）
tls_enable = false

# 日志配置
[log]
level = "info"
file = ""
